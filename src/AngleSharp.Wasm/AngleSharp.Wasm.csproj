<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>AngleSharp.Wasm</AssemblyName>
    <RootNamespace>AngleSharp.Wasm</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Marks the package trimmable and AOT-compatible, and runs the trim, AOT and single-file
         analyzers on every build. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- IsAotCompatible makes the SDK reference Microsoft.NET.ILLink.Tasks implicitly, at the version
       its KnownILLinkPack table lists per target (8.0.x for net8.0, 10.0.x for net10.0). Two versions
       of one package in one project make Visual Studio's NuGet Consolidate tab report it, so every
       target uses the trimmer of the SDK doing the build instead. Following the SDK's bundled version
       keeps it current without pinning, and covers the next pair of targets too (net10.0 next to net11.0).
       KnownILLinkPack is SDK-internal and undocumented: if an SDK renames or reshapes it, this goes
       inert or fails the restore - drop it then, or once only one .NETCoreApp target is left. -->
  <ItemGroup>
    <KnownILLinkPack Update="Microsoft.NET.ILLink.Tasks" ILLinkPackVersion="$(BundledNETCoreAppPackageVersion)" />
  </ItemGroup>

  <PropertyGroup Label="Packaging">
    <PackageProjectUrl>https://anglesharp.github.io</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>html;html5;css;css3;dom;requester;http;https;wasm;web;assembly;anglesharp;angle</PackageTags>
    <PackageReleaseNotes>https://github.com/AngleSharp/AngleSharp.Wasm/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/AngleSharp/AngleSharp.Wasm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AngleSharpVersion Condition=" '$(AngleSharpVersion)' == '' ">1.5.0</AngleSharpVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All" />
    <PackageReference Include="Wasmtime" Version="44.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="$(AngleSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\logo.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AngleSharp.Wasm.Tests, " />
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
    <DelaySign>false</DelaySign>
  </PropertyGroup>
</Project>